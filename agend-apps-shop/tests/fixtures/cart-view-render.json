{
    "defaults": "\t<div class=\"agend-apps-shop-cart-view elementor-widget-container\">\n\t\t<div class=\"agend-shop-cart-loading\" aria-live=\"polite\">Loading cart&amp;hellip;</div>\n\n\t\t<div class=\"agend-shop-cart-empty\" hidden>\n\t\t\t<p>Your cart is empty.</p>\n\t\t</div>\n\n\t\t<div class=\"agend-shop-cart-locked-notice\" hidden>\n\t\t\t<p>Your cart is currently locked while a checkout is in progress. Cancel the checkout below to make changes.</p>\n\t\t</div>\n\n\t\t<div class=\"agend-shop-cart-content\" hidden>\n\t\t\t<table class=\"agend-shop-cart-table\">\n\t\t\t\t<thead>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<th scope=\"col\">Item</th>\n\t\t\t\t\t\t<th scope=\"col\">Unit Price</th>\n\t\t\t\t\t\t<th scope=\"col\">Quantity</th>\n\t\t\t\t\t\t<th scope=\"col\">Subtotal</th>\n\t\t\t\t\t\t<th scope=\"col\"><span class=\"screen-reader-text\">Actions</span></th>\n\t\t\t\t\t</tr>\n\t\t\t\t</thead>\n\t\t\t\t<tbody class=\"agend-shop-cart-items\"></tbody>\n\t\t\t\t<tfoot>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td colspan=\"3\" class=\"agend-shop-cart-total-label\">Total</td>\n\t\t\t\t\t\t<td class=\"agend-shop-cart-total-amount\"></td>\n\t\t\t\t\t\t<td></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tfoot>\n\t\t\t</table>\n\n\t\t\t<div class=\"agend-shop-cart-actions\">\n\t\t\t\t<button class=\"agend-shop-btn-clear-cart\">Clear Cart</button>\n\t\t\t\t<div class=\"agend-shop-cart-primary-actions\">\n\t\t\t\t\t<button class=\"agend-shop-btn-proceed-checkout elementor-button\">Proceed to Checkout</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"agend-shop-cart-test-actions\">\n\t\t\t\t<p><strong>Testing only:</strong></p>\n\t\t\t\t<button class=\"agend-shop-btn-complete-checkout\">Complete Checkout</button>\n\t\t\t\t<button class=\"agend-shop-btn-cancel-checkout\">Cancel Checkout</button>\n\t\t\t</div>\n\n\t\t\t<div class=\"agend-shop-cart-message\" aria-live=\"polite\"></div>\n\t\t</div>\n\n\t\t<!-- Confirmation modal for clear cart -->\n\t\t<div class=\"agend-shop-confirm-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"agend-shop-confirm-title\" hidden>\n\t\t\t<div class=\"agend-shop-confirm-modal-inner\">\n\t\t\t\t<p id=\"agend-shop-confirm-title\">Are you sure you want to clear your cart? This cannot be undone.</p>\n\t\t\t\t<button class=\"agend-shop-btn-confirm-yes\">Yes, clear cart</button>\n\t\t\t\t<button class=\"agend-shop-btn-confirm-no\">Cancel</button>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t"
