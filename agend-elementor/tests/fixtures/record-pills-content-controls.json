{
    "sections": [
        {
            "id": "section_pills",
            "args": {
                "label": "Pills",
                "tab": "content"
            },
            "controls": [
                {
                    "id": "field",
                    "args": {
                        "label": "Terms",
                        "type": "select",
                        "default": "common:category",
                        "groups": [
                            {
                                "label": "Common (any record)",
                                "options": {
                                    "common:category": "Category",
                                    "common:custom_field": "Custom field (by key)"
                                }
                            },
                            {
                                "label": "Directory listing",
                                "options": {
                                    "listing:category": "Category",
                                    "listing:categories": "All categories",
                                    "listing:tags": "Tags",
                                    "listing:badges": "Badges",
                                    "listing:locations": "All locations",
                                    "listing:state": "State"
                                }
                            },
                            {
                                "label": "Event",
                                "options": {
                                    "event:venue_type": "Format (In-Person, Online, Hybrid)",
                                    "event:category": "Category",
                                    "event:categories": "All categories",
                                    "event:tags": "Tags"
                                }
                            },
                            {
                                "label": "Course",
                                "options": {
                                    "course:category": "Category",
                                    "course:difficulty": "Level",
                                    "course:delivery_mode": "Delivery mode"
                                }
                            }
                        ],
                        "label_block": true,
                        "description": "A list field renders one pill per term. A single-value field renders one pill."
                    }
                },
                {
                    "id": "custom_field_key_choice",
                    "args": {
                        "label": "Custom field",
                        "type": "select",
                        "default": "",
                        "options": {
                            "": "Not listed (enter a key below)"
                        },
                        "label_block": true,
                        "description": "A multi-select or checkbox field renders one pill per selected option.",
                        "condition": {
                            "field": "common:custom_field"
                        }
                    }
                },
                {
                    "id": "custom_field_key",
                    "args": {
                        "label": "Custom field key",
                        "type": "text",
                        "default": "",
                        "description": "The key as configured in Agend, for a field this site's key cannot enumerate.",
                        "condition": {
                            "field": "common:custom_field",
                            "custom_field_key_choice": ""
                        }
                    }
                },
                {
                    "id": "max_items",
                    "args": {
                        "label": "Maximum pills",
                        "type": "number",
                        "default": 0,
                        "min": 0,
                        "description": "0 shows every term."
                    }
                },
                {
                    "id": "show_rest",
                    "args": {
                        "label": "Show the rest",
                        "type": "switcher",
                        "default": "",
                        "description": "With a maximum set, adds a control after the last item shown that reveals the rest in place, and hides them again."
                    }
                },
                {
                    "id": "overflow_text",
                    "args": {
                        "label": "Overflow text",
                        "type": "text",
                        "default": "+{n}",
                        "description": "{n} is replaced by the number of hidden items.",
                        "condition": {
                            "show_rest": "yes"
                        }
                    }
                },
                {
                    "id": "collapse_text",
                    "args": {
                        "label": "Collapse text",
                        "type": "text",
                        "default": "Show less",
                        "condition": {
                            "show_rest": "yes"
                        }
                    }
                },
                {
                    "id": "link_to_detail",
                    "args": {
                        "label": "Link pills to the detail page",
                        "type": "switcher",
                        "default": ""
                    }
                },
                {
                    "id": "label_heading",
                    "args": {
                        "label": "Label",
                        "type": "heading",
                        "separator": "before"
                    }
                },
                {
                    "id": "show_label",
                    "args": {
                        "label": "Show label",
                        "type": "switcher",
                        "default": "",
                        "description": "Puts the field's own name before the pills."
                    }
                },
                {
                    "id": "label_text",
                    "args": {
                        "label": "Label text",
                        "type": "text",
                        "default": "",
                        "description": "Leave empty to use the field's own name.",
                        "condition": {
                            "show_label": "yes"
                        }
                    }
                },
                {
                    "id": "label_block_display",
                    "args": {
                        "label": "Label on its own line",
                        "type": "switcher",
                        "default": "",
                        "condition": {
                            "show_label": "yes"
                        }
                    }
                }
            ]
        }
    ]
}
