{
    "sections": [
        {
            "id": "section_filter",
            "args": {
                "label": "Filter",
                "tab": "content"
            },
            "controls": [
                {
                    "id": "filter",
                    "args": {
                        "label": "Filter",
                        "type": "select",
                        "default": "event:search",
                        "groups": [
                            {
                                "label": "Events",
                                "options": {
                                    "event:search": "Search",
                                    "event:reset": "Clear filters",
                                    "event:category": "Category",
                                    "event:venue_type": "Format",
                                    "event:city": "City",
                                    "event:date_from": "Starting from",
                                    "event:date_to": "Starting before"
                                }
                            },
                            {
                                "label": "Courses",
                                "options": {
                                    "course:search": "Search",
                                    "course:reset": "Clear filters",
                                    "course:category": "Category",
                                    "course:difficulty": "Level",
                                    "course:delivery_mode": "Delivery mode"
                                }
                            },
                            {
                                "label": "Directory",
                                "options": {
                                    "listing:search": "Search",
                                    "listing:reset": "Clear filters",
                                    "listing:category": "Category",
                                    "listing:city": "City",
                                    "listing:state": "State",
                                    "listing:postcode": "Postcode",
                                    "listing:country": "Country",
                                    "listing:rating": "Minimum rating",
                                    "listing:sort": "Sort by",
                                    "listing:featured": "Featured",
                                    "listing:tag": "Tag",
                                    "listing:badge": "Badge",
                                    "listing:location": "Location",
                                    "listing:view": "View",
                                    "listing:custom_field": "Custom field"
                                }
                            }
                        ],
                        "label_block": true,
                        "description": "Choose the filter for the catalogue this template belongs to. A filter from another catalogue renders nothing."
                    }
                },
                {
                    "id": "custom_field_key",
                    "args": {
                        "label": "Custom field key",
                        "type": "text",
                        "default": "",
                        "description": "The key as configured in Agend, for example education_level. The field must be configured as a search filter on the account, and a visitor who is not entitled to read it never sees this control.",
                        "condition": {
                            "filter": "listing:custom_field"
                        }
                    }
                },
                {
                    "id": "control",
                    "args": {
                        "label": "Presentation",
                        "type": "select",
                        "default": "",
                        "options": {
                            "": "Default for this filter",
                            "search": "Search box",
                            "select": "Dropdown",
                            "checkboxes": "Checkboxes",
                            "buttons": "Buttons",
                            "date": "Date",
                            "range": "Number range",
                            "reset": "Clear button",
                            "location": "Location search",
                            "view": "List / Map switch"
                        },
                        "description": "Presentations the chosen filter does not support fall back to its default."
                    }
                },
                {
                    "id": "show_label",
                    "args": {
                        "label": "Show label",
                        "type": "switcher",
                        "default": "yes"
                    }
                },
                {
                    "id": "label",
                    "args": {
                        "label": "Label",
                        "type": "text",
                        "default": "",
                        "description": "Leave empty for the filter's own name."
                    }
                },
                {
                    "id": "placeholder",
                    "args": {
                        "label": "Placeholder",
                        "type": "text",
                        "default": "",
                        "condition": {
                            "control": [
                                "",
                                "search",
                                "date",
                                "reset"
                            ]
                        }
                    }
                },
                {
                    "id": "any_label",
                    "args": {
                        "label": "\"Any\" option label",
                        "type": "text",
                        "default": "",
                        "description": "The option that clears this filter, for example \"All Categories\".",
                        "condition": {
                            "control!": [
                                "search",
                                "date"
                            ],
                            "filter!": [
                                "listing:location",
                                "listing:view"
                            ]
                        }
                    }
                },
                {
                    "id": "location_heading",
                    "args": {
                        "label": "Location search",
                        "type": "heading",
                        "separator": "before",
                        "condition": {
                            "filter": "listing:location"
                        }
                    }
                },
                {
                    "id": "location_show_search",
                    "args": {
                        "label": "Place search box",
                        "type": "switcher",
                        "default": "yes",
                        "description": "A box for an address, suburb or postcode. It is hidden on the live page when the account does not include place search.",
                        "condition": {
                            "filter": "listing:location"
                        }
                    }
                },
                {
                    "id": "location_button_text",
                    "args": {
                        "label": "Search button text",
                        "type": "text",
                        "default": "",
                        "placeholder": "Search",
                        "condition": {
                            "filter": "listing:location",
                            "location_show_search": "yes"
                        }
                    }
                },
                {
                    "id": "location_region",
                    "args": {
                        "label": "Region",
                        "type": "text",
                        "default": "",
                        "placeholder": "Australia",
                        "description": "Added to every place search, so a suburb that exists in several countries resolves to the right one. Leave empty to search worldwide.",
                        "condition": {
                            "filter": "listing:location",
                            "location_show_search": "yes"
                        }
                    }
                },
                {
                    "id": "location_show_locate",
                    "args": {
                        "label": "\"Use my location\" button",
                        "type": "switcher",
                        "default": "yes",
                        "description": "Asks the visitor's browser for their position. Always shown when the place search box is off.",
                        "condition": {
                            "filter": "listing:location"
                        }
                    }
                },
                {
                    "id": "location_locate_text",
                    "args": {
                        "label": "\"Use my location\" text",
                        "type": "text",
                        "default": "",
                        "placeholder": "Use my location",
                        "condition": {
                            "filter": "listing:location"
                        }
                    }
                },
                {
                    "id": "location_radius_choices",
                    "args": {
                        "label": "Radius choices (km)",
                        "type": "text",
                        "default": "5,10,15,20,25,50,100",
                        "description": "Separated by commas. A single value fixes the radius and hides the dropdown.",
                        "condition": {
                            "filter": "listing:location"
                        }
                    }
                },
                {
                    "id": "location_radius_default",
                    "args": {
                        "label": "Default radius (km)",
                        "type": "number",
                        "default": 15,
                        "min": 1,
                        "max": 1000,
                        "step": 1,
                        "condition": {
                            "filter": "listing:location"
                        }
                    }
                },
                {
                    "id": "view_heading",
                    "args": {
                        "label": "List / Map switch",
                        "type": "heading",
                        "separator": "before",
                        "condition": {
                            "filter": "listing:view"
                        }
                    }
                },
                {
                    "id": "view_default",
                    "args": {
                        "label": "Starts on",
                        "type": "select",
                        "default": "list",
                        "options": {
                            "list": "List",
                            "map": "Map"
                        },
                        "description": "Pair this with an Agend Map widget set to \"Show only in Map view\". Without one, Map shows nothing.",
                        "condition": {
                            "filter": "listing:view"
                        }
                    }
                },
                {
                    "id": "view_list_label",
                    "args": {
                        "label": "List button text",
                        "type": "text",
                        "default": "",
                        "placeholder": "List",
                        "condition": {
                            "filter": "listing:view"
                        }
                    }
                },
                {
                    "id": "view_map_label",
                    "args": {
                        "label": "Map button text",
                        "type": "text",
                        "default": "",
                        "placeholder": "Map",
                        "condition": {
                            "filter": "listing:view"
                        }
                    }
                }
            ]
        },
        {
            "id": "section_values",
            "args": {
                "label": "Values",
                "tab": "content",
                "condition": {
                    "control!": [
                        "search",
                        "date",
                        "reset",
                        "range",
                        "location",
                        "view"
                    ],
                    "filter!": [
                        "listing:location",
                        "listing:view"
                    ]
                }
            },
            "controls": [
                {
                    "id": "values_mode",
                    "args": {
                        "label": "Values",
                        "type": "select",
                        "default": "all",
                        "options": {
                            "all": "Every value that exists",
                            "choices": "Choices I define"
                        },
                        "description": "Defined choices each send a fixed selection, so one choice can stand for several values, for example \"All States\". Tag and badge filters always use defined choices, because the API cannot list their values yet."
                    }
                },
                {
                    "id": "choices",
                    "args": {
                        "label": "Choices",
                        "type": "repeater",
                        "fields": [
                            {
                                "label": "Label",
                                "type": "text",
                                "default": "",
                                "name": "choice_label"
                            },
                            {
                                "label": "Sends",
                                "type": "text",
                                "default": "",
                                "description": "One value, or several separated by commas. Several values match any of them.",
                                "name": "choice_value"
                            }
                        ],
                        "title_field": "{{{ choice_label }}}",
                        "default": [],
                        "condition": {
                            "values_mode": "choices"
                        }
                    }
                }
            ]
        }
    ]
}
