{
  "description": "Search link cases shared by the browser's parse rules (decode() in assets/js/search-link.js, run by tests/js/search-link.test.mjs) and the server's (agend_apps_records_search_link_decode() in includes/records/search-link.php, run by SearchLinkParseTest.php). Each decode case reads `query` with the filters named by `controls` on the page, with a map that updates results as it moves when `bbox` is true, and must produce `expect`. Each encode case writes `state` with `options` and must produce `query` exactly; it runs in the Node suite only, because only the browser writes search links. Each case carries 'outcome' and 'when', which name its test: should <outcome> when <when>.",
  "controls": {
    "full": [
      {
        "type": "listing",
        "state": "search",
        "mode": "scalar",
        "control": "search",
        "filter": "search"
      },
      {
        "type": "listing",
        "state": "location_name",
        "mode": "scalar",
        "control": "search",
        "filter": "organisation"
      },
      {
        "type": "listing",
        "state": "categories",
        "mode": "array",
        "control": "select",
        "filter": "category"
      },
      {
        "type": "listing",
        "state": "location_city",
        "mode": "array",
        "control": "checkboxes",
        "filter": "city"
      },
      {
        "type": "listing",
        "state": "location_state",
        "mode": "array",
        "control": "select",
        "filter": "state"
      },
      {
        "type": "listing",
        "state": "location_postcode",
        "mode": "array",
        "control": "select",
        "filter": "postcode"
      },
      {
        "type": "listing",
        "state": "location_country",
        "mode": "array",
        "control": "select",
        "filter": "country"
      },
      {
        "type": "listing",
        "state": "tag_ids",
        "mode": "array",
        "control": "checkboxes",
        "filter": "tag"
      },
      {
        "type": "listing",
        "state": "badge_ids",
        "mode": "array",
        "control": "buttons",
        "filter": "badge"
      },
      {
        "type": "listing",
        "state": "rating",
        "mode": "scalar",
        "control": "select",
        "filter": "rating"
      },
      {
        "type": "listing",
        "state": "sortBy",
        "mode": "scalar",
        "control": "select",
        "filter": "sort"
      },
      {
        "type": "listing",
        "state": "featured",
        "mode": "scalar",
        "control": "buttons",
        "filter": "featured"
      },
      {
        "type": "listing",
        "state": "near",
        "mode": "location",
        "control": "location",
        "filter": "location",
        "location": {
          "radii": [
            5,
            10,
            15,
            20,
            25,
            50,
            100
          ],
          "radius": 15
        }
      },
      {
        "type": "listing",
        "state": "view",
        "mode": "view",
        "control": "view",
        "filter": "view",
        "view": {
          "default": "list"
        }
      },
      {
        "type": "listing",
        "state": "custom_fields",
        "mode": "map",
        "control": "select",
        "filter": "custom_field",
        "fieldKey": "education_level"
      },
      {
        "type": "listing",
        "state": "custom_fields",
        "mode": "map",
        "control": "checkboxes",
        "filter": "custom_field",
        "fieldKey": "funding"
      },
      {
        "type": "listing",
        "state": "custom_fields",
        "mode": "map",
        "control": "range",
        "filter": "custom_field",
        "fieldKey": "fees"
      },
      {
        "type": "listing",
        "state": "custom_fields",
        "mode": "map",
        "control": "range_brackets",
        "filter": "custom_field",
        "fieldKey": "price"
      },
      {
        "type": "listing",
        "state": "",
        "mode": "scalar",
        "control": "reset",
        "filter": "reset"
      },
      {
        "type": "listing",
        "state": "",
        "mode": "scalar",
        "control": "share",
        "filter": "share"
      }
    ],
    "none": [],
    "reset_only": [
      {
        "type": "listing",
        "state": "",
        "mode": "scalar",
        "control": "reset",
        "filter": "reset"
      }
    ]
  },
  "cases": [
    {
      "name": "decode_01",
      "outcome": "read nothing",
      "when": "the address has no query string",
      "controls": "full",
      "bbox": true,
      "query": "",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_02",
      "outcome": "read the search text",
      "when": "q is set",
      "controls": "full",
      "bbox": true,
      "query": "q=Sarah+Smith",
      "expect": {
        "state": {
          "search": "Sarah Smith"
        },
        "page": 1
      }
    },
    {
      "name": "decode_03",
      "outcome": "take the last value",
      "when": "a parameter repeats",
      "controls": "full",
      "bbox": true,
      "query": "q=first&q=second",
      "expect": {
        "state": {
          "search": "second"
        },
        "page": 1
      }
    },
    {
      "name": "decode_04",
      "outcome": "ignore a bracketed name",
      "when": "a parameter is sent as an array",
      "controls": "full",
      "bbox": true,
      "query": "q[]=Sarah",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_05",
      "outcome": "keep an invalid percent sequence as written",
      "when": "q holds one",
      "controls": "full",
      "bbox": true,
      "query": "q=100%ZZ",
      "expect": {
        "state": {
          "search": "100%ZZ"
        },
        "page": 1
      }
    },
    {
      "name": "decode_06",
      "outcome": "drop whitespace-only text",
      "when": "q holds only spaces",
      "controls": "full",
      "bbox": true,
      "query": "q=+++",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_07",
      "outcome": "keep a non-breaking space",
      "when": "q starts and ends with one",
      "controls": "full",
      "bbox": true,
      "query": "q=%C2%A0Sarah%C2%A0",
      "expect": {
        "state": {
          "search": " Sarah "
        },
        "page": 1
      }
    },
    {
      "name": "decode_08",
      "outcome": "cut the search text to 200 characters",
      "when": "q is longer",
      "controls": "full",
      "bbox": true,
      "query": "q=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expect": {
        "state": {
          "search": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "page": 1
      }
    },
    {
      "name": "decode_09",
      "outcome": "cut by character, not by UTF-16 unit",
      "when": "q is 201 emoji",
      "controls": "full",
      "bbox": true,
      "query": "q=%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80%F0%9F%98%80",
      "expect": {
        "state": {
          "search": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀"
