    {
      "name": "decode_10",
      "outcome": "ignore every search parameter",
      "when": "the template has no filters",
      "controls": "none",
      "bbox": true,
      "query": "q=Sarah&rating=4&cf_funding=ndis&near=-37.8,144.96&view=map",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_11",
      "outcome": "ignore a value no control writes",
      "when": "only a reset filter is present",
      "controls": "reset_only",
      "bbox": true,
      "query": "rating=4&sort=name",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_12",
      "outcome": "ignore a parameter the table does not name",
      "when": "utm parameters are present",
      "controls": "full",
      "bbox": true,
      "query": "utm_source=mail&gclid=abc&rating=4",
      "expect": {
        "state": {
          "rating": "4"
        },
        "page": 1
      }
    },
    {
      "name": "decode_13",
      "outcome": "read category ids in lower case and drop entries that are not UUIDs",
      "when": "category_ids mixes valid and invalid entries",
      "controls": "full",
      "bbox": true,
      "query": "category_ids=11111111-2222-4333-8444-555555555555,not-a-uuid,aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
      "expect": {
        "state": {
          "categories": [
            "11111111-2222-4333-8444-555555555555",
            "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
          ]
        },
        "page": 1
      }
    },
    {
      "name": "decode_14",
      "outcome": "read tag and badge ids",
      "when": "tag_ids and badge_ids are set",
      "controls": "full",
      "bbox": true,
      "query": "tag_ids=11111111-2222-4333-8444-555555555555&badge_ids=aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee,x",
      "expect": {
        "state": {
          "tag_ids": [
            "11111111-2222-4333-8444-555555555555"
          ],
          "badge_ids": [
            "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
          ]
        },
        "page": 1
      }
    },
    {
      "name": "decode_15",
      "outcome": "keep a value whose comma and percent sign were escaped",
      "when": "a custom field value holds both",
      "controls": "full",
      "bbox": true,
      "query": "cf_funding=ndis,home%252Ccare,50%2525",
      "expect": {
        "state": {
          "custom_fields": {
            "funding": [
              "ndis",
              "home,care",
              "50%"
            ]
          }
        },
        "page": 1
      }
    },
    {
      "name": "decode_16",
      "outcome": "drop empty list entries",
      "when": "a list has doubled commas",
      "controls": "full",
      "bbox": true,
      "query": "cf_funding=,ndis,,",
      "expect": {
        "state": {
          "custom_fields": {
            "funding": [
              "ndis"
            ]
          }
        },
        "page": 1
      }
    },
    {
      "name": "decode_17",
      "outcome": "drop a cf_ value for a range control",
      "when": "fees has a number range control",
      "controls": "full",
      "bbox": true,
      "query": "cf_fees=100",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_18",
      "outcome": "drop an rf_ value for a value-list control",
      "when": "funding has checkboxes",
      "controls": "full",
      "bbox": true,
      "query": "rf_funding=1:2",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_19",
      "outcome": "drop a custom field with no control",
      "when": "cf_unknown is set",
      "controls": "full",
      "bbox": true,
      "query": "cf_unknown=x&rf_unknown=1:2",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_20",
      "outcome": "read both bounds of a range",
      "when": "rf_fees has a minimum and a maximum",
      "controls": "full",
      "bbox": true,
      "query": "rf_fees=100:500",
      "expect": {
        "state": {
          "custom_fields": {
            "fees": {
              "min": "100",
              "max": "500"
            }
          }
        },
        "page": 1
      }
    },
    {
      "name": "decode_21",
      "outcome": "read an open-ended range",
      "when": "rf_fees has only a maximum",
      "controls": "full",
      "bbox": true,
      "query": "rf_fees=:500",
      "expect": {
        "state": {
          "custom_fields": {
            "fees": {
              "max": "500"
            }
          }
        },
        "page": 1
      }
    },
    {
      "name": "decode_22",
      "outcome": "read a range for a range bracket control",
      "when": "rf_price is set",
      "controls": "full",
      "bbox": true,
      "query": "rf_price=10000:",
      "expect": {
        "state": {
          "custom_fields": {
            "price": {
              "min": "10000"
            }
          }
        },
        "page": 1
      }
    },
    {
      "name": "decode_23",
      "outcome": "drop a range with neither bound",
      "when": "rf_fees is a bare colon",
      "controls": "full",
      "bbox": true,
      "query": "rf_fees=:",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_24",
      "outcome": "drop a range with a bound that is not a number",
      "when": "rf_fees has text or an exponent",
      "controls": "full",
      "bbox": true,
      "query": "rf_fees=abc:5&rf_price=1e3:",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_25",
      "outcome": "drop a range without a colon",
      "when": "rf_fees is one number",
      "controls": "full",
      "bbox": true,
      "query": "rf_fees=100",
      "expect": {
        "state": {},
        "page": 1
      }
    },
    {
      "name": "decode_26",
      "outcome": "sort custom fields by key",
      "when": "their parameters arrive out of order",
      "controls": "full",
      "bbox": true,
      "query": "rf_price=1:2&cf_funding=ndis&cf_education_level=masters",
      "expect": {
        "state": {
          "custom_fields": {
            "education_level": [
              "masters"
            ],
            "funding": [
              "ndis"
            ],
            "price": {
              "min": "1",
              "max": "2"
            }
          }
        },
        "page": 1
      }
    },
    {
      "name": "decode_27",
      "outcome": "keep an apostrophe and a backslash in a location name",
      "when": "location_name holds both",
      "controls": "full",
      "bbox": true,
      "query": "location_name=St+Vincent%27s+%5C+Co",
      "expect": {
        "state": {
          "location_name": "St Vincent's \\ Co"
        },
        "page": 1
      }
    },
    {
      "name": "decode_28",
      "outcome": "cut a location name to 100 characters",
      "when": "location_name is longer",
      "controls": "full",
      "bbox": true,
      "query": "location_name=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "expect": {
        "state": {
          "location_name": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        },
        "page": 1
      }
    },
    {
      "name": "decode_29",
      "outcome": "drop a location value over 100 characters",
      "when": "city holds one",
      "controls": "full",
      "bbox": true,
      "query": "city=Carlton,ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc,Fitzroy",
      "expect": {
        "state": {
          "location_city": [
            "Carlton",
            "Fitzroy"
          ]
        },
        "page": 1
      }
    },
    {
      "name": "decode_30",
      "outcome": "read only the first 50 location values",
      "when": "state holds 55",
